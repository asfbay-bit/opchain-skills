{
  "name": "opchain-dev",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "npm run prebuild && wrangler dev",
    "build": "node build.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:staging": "node scripts/deploy.mjs --staging",
    "deploy:skip-build": "wrangler deploy --config wrangler.jsonc --no-build",
    "smoke": "bash scripts/smoke.sh",
    "smoke:prod": "DEPLOY_URL=https://opchain.dev bash scripts/smoke.sh",
    "smoke:staging": "DEPLOY_URL=https://staging.opchain.dev bash scripts/smoke.sh",
    "sync-docs": "bash scripts/sync-docs.sh",
    "make-zip": "bash scripts/make-skills-zip.sh",
    "gen-catalog": "node scripts/gen-skills-catalog.mjs",
    "lint-internal-refs": "node scripts/lint-internal-refs.mjs",
    "check-skill-flags": "OPCHAIN_STRICT_REGISTRY=1 node scripts/check-skill-flags.mjs",
    "check-skill-contracts": "node scripts/check-skill-contracts.mjs",
    "release-sequence": "node scripts/release-sequence.mjs",
    "hardening:verify": "node scripts/check-hardening.mjs --pre-deploy",
    "test:mcp-hardening": "vitest run tests/mcp-server.test.js tests/mcp-route.test.js",
    "test:data-retention": "vitest run tests/notify.test.js",
    "check-release-tag": "node scripts/check-release-tag.mjs",
    "gen-mcp-catalog": "node scripts/gen-mcp-catalog.mjs",
    "gen-flags": "node scripts/gen-flags.mjs",
    "gen-stack-packs": "node scripts/gen-stack-packs.mjs",
    "gen-api-dev-adapters": "node scripts/gen-api-dev-adapters.mjs",
    "gen-packs-catalog": "node scripts/gen-packs-catalog.mjs",
    "gen-og": "node scripts/gen-og-images.mjs",
    "gen-roadmap": "node scripts/gen-roadmap.mjs",
    "validate-pm-mcp": "node scripts/validate-pm-mcp.mjs",
    "sync-bundles": "node scripts/build-runtime.mjs && node scripts/sync-skill-bundles.mjs",
    "sync-bundles:check": "node scripts/build-runtime.mjs --check && node scripts/sync-skill-bundles.mjs --check",
    "sync-plugin-skills": "node scripts/sync-plugin-skills.mjs",
    "sync-plugin-skills:check": "node scripts/sync-plugin-skills.mjs --check",
    "build-site": "bash scripts/build-site.sh",
    "prebuild": "npm run gen-stack-packs && npm run gen-api-dev-adapters && npm run gen-packs-catalog && npm run gen-flags && npm run gen-catalog && npm run lint-internal-refs && npm run check-skill-flags && npm run check-skill-contracts && npm run gen-mcp-catalog && npm run validate-pm-mcp && npm run sync-bundles:check && npm run sync-plugin-skills:check && npm run sync-docs && npm run make-zip && npm run build-update-bundle && npm run gen-og && npm run build-site",
    "pretest": "npm run gen-stack-packs && npm run gen-api-dev-adapters && npm run gen-packs-catalog && npm run gen-flags && npm run gen-catalog && npm run lint-internal-refs && npm run check-skill-flags && npm run check-skill-contracts && npm run gen-mcp-catalog && npm run validate-pm-mcp && npm run sync-bundles:check && npm run sync-plugin-skills:check && npm run sync-docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "site:install": "cd site && npm install",
    "site:dev": "cd site && npm run dev",
    "site:build": "cd site && npm run build",
    "telemetry": "node --disable-warning=ExperimentalWarning scripts/telemetry.mjs",
    "checkpoint": "node scripts/checkpoint.mjs",
    "checkpoint:status": "node scripts/checkpoint.mjs status",
    "checkpoint:next": "node scripts/checkpoint.mjs next",
    "checkpoint:doctor": "node scripts/checkpoint.mjs doctor",
    "checkpoint:validate": "node scripts/checkpoint.mjs validate",
    "prepare": "node scripts/install-git-drivers.mjs",
    "test:hooks": "node plugins/opchain/hooks/test-gate.cjs && node plugins/opchain/hooks/test-suggestion.cjs",
    "capabilities": "node scripts/capabilities.mjs",
    "capabilities:generate": "node scripts/capabilities.mjs --generate",
    "verify:candidate": "node scripts/verify-candidate.mjs run",
    "oc-prompt": "node scripts/prompt-eval.mjs",
    "oc-cost": "node scripts/cost.mjs",
    "runtime:package": "node scripts/package-runtime.mjs",
    "evidence:pr": "node scripts/lib/release-evidence.mjs --stage pr",
    "evidence:deploy": "node scripts/lib/release-evidence.mjs --stage deploy",
    "build-update-bundle": "node scripts/build-update-bundle.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "js-yaml": "^5.4.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.0"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
